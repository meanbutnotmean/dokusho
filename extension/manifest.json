{
  "manifest_version": 3,
  "name": "Dokusho Dictionary",
  "version": "0.1.0",
  "description": "Look up words on the web with your imported dictionaries.",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Look up selected text"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
